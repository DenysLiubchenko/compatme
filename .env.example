# Copy this file to `.env` (same directory as docker-compose.yml) and fill in the values.
# `.env` is read automatically by `docker compose`. Never commit your real `.env` file.

# ============================================================================
# REQUIRED
# ============================================================================

# Gemini Developer API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================================================
# OPTIONAL — Gemini model / retry tuning (sensible defaults already set in docker-compose.yml)
# ============================================================================

# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONALITY=768
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_MAX_RETRY_ATTEMPTS=4
# GEMINI_RETRY_INITIAL_BACKOFF_MILLIS=1000
# GEMINI_RETRY_BACKOFF_MULTIPLIER=2.0

# ============================================================================
# OPTIONAL — Telegram bot client
# ============================================================================

# Set to true to start the Telegram long-polling bot alongside the backend.
# TELEGRAM_BOT_ENABLED=false

# Required only if TELEGRAM_BOT_ENABLED=true. Token issued by @BotFather.
# TELEGRAM_BOT_TOKEN=

# Required only if TELEGRAM_BOT_ENABLED=true. Bot username registered with @BotFather.
# TELEGRAM_BOT_USERNAME=

# ============================================================================
# OPTIONAL — sample data
# ============================================================================

# Set to true to seed ~6 sample Ukrainian-language profiles (and their embeddings) at startup.
# SEED_DATA_ENABLED=false

# ============================================================================
# OPTIONAL — ports / misc
# ============================================================================

# Host port the backend is published on (container always listens on 8080 internally).
# SERVER_PORT=8080

# Password for the optional mongo-express web UI (username is always "admin").
# MONGO_EXPRESS_PASSWORD=admin
